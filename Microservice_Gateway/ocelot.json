{
  "Routes": [

    {
      "DownstreamPathTemplate": "/api/Auth/Login",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7278
        }
      ],
      "UpstreamPathTemplate": "/login",
      "UpstreamHttpMethod": [ "Post" ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Limit": 5,
        "Period": "30s",
        "ClientIdHeader" :  "X-Client-Id",
        "QuotaExceededMessage": "Too Many Requests, Please Try Again!",
        "HttpStatusCode" : 429
      }
    },
    {
      "DownstreamPathTemplate": "/api/Auth/Register",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7278
        }
      ],
      "UpstreamPathTemplate": "/register",
      "UpstreamHttpMethod": [ "Post" ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Limit": 3,
        "Period": "1m",
        "ClientIdHeader": "X-Client-Id",
        "QuotaExceededMessage": "Too Many Requests, Please Try Again!",
        "HttpStatusCode": 429
      }
    },
    {
      "DownstreamPathTemplate": "/api/Orders/CreateOrders",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7175
        }
      ],
      "UpstreamPathTemplate": "/CreateOrders",
      "UpstreamHttpMethod": [ "Post" ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Limit": 5,
        "Period": "30s",
        "ClientIdHeader": "X-Client-Id",
        "QuotaExceededMessage": "Too Many Requests, Please Try Again!",
        "HttpStatusCode": 429
      },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/Orders/GetOrders",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7175
        }
      ],
      "UpstreamPathTemplate": "/GetOrders",
      "UpstreamHttpMethod": [ "Get" ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Limit": 20,
        "Period": "60s",
        "ClientIdHeader": "X-Client-Id",
        "QuotaExceededMessage": "Too Many Requests, Please Try Again!",
        "HttpStatusCode": 429
      },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    }

  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7074",
    "RateLimitOptions": {
      "DisableRateLimitHeader": false,     
      "ClientIdHeader": "X-Client-Id",
      "QuotaExceededMessage": "Too Many Requests, Please Try Again!",
      "HttpStatusCode": 429
    }
  }
}